{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "externalVehicleState",
    "description": "Observations of an independently controlled vehicle.",
    "subtopic": "/externalVehicleState",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "headerId",
        "timestamp",
        "version",
        "manufacturer",
        "serialNumber",
        "measurementTimestamp",
        "mobileRobotPosition"
    ],
    "properties": {
        "headerId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "version": {
            "type": "string",
            "description": "Version of the protocol [Major].[Minor].[Patch].",
            "examples": [
                "3.1.0"
            ]
        },
        "manufacturer": {
            "type": "string",
            "minLength": 1,
            "not": {
                "pattern": "[/+#$\\u0000-\\u001f]"
            }
        },
        "serialNumber": {
            "type": "string",
            "minLength": 1,
            "description": "Characters specified for serialNumber in Section 4.2.",
            "not": {
                "pattern": "[^A-Za-z0-9_.:-]"
            }
        },
        "measurementTimestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "mobileRobotPosition": {
            "$ref": "#/$defs/position"
        },
        "velocity": {
            "$ref": "#/$defs/velocity"
        }
    },
    "if": {
        "properties": {
            "mobileRobotPosition": {
                "properties": {
                    "localized": {
                        "const": false
                    }
                }
            }
        }
    },
    "then": {
        "not": {
            "required": [
                "velocity"
            ]
        }
    },
    "$defs": {
        "position": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "localized",
                        "x",
                        "y",
                        "theta",
                        "mapId"
                    ],
                    "properties": {
                        "localized": {
                            "const": true
                        },
                        "x": {
                            "type": "number",
                            "minimum": -1.7976931348623157e+308,
                            "maximum": 1.7976931348623157e+308,
                            "unit": "m"
                        },
                        "y": {
                            "type": "number",
                            "minimum": -1.7976931348623157e+308,
                            "maximum": 1.7976931348623157e+308,
                            "unit": "m"
                        },
                        "theta": {
                            "type": "number",
                            "minimum": -3.14159265359,
                            "maximum": 3.14159265359,
                            "unit": "rad"
                        },
                        "mapId": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "localized"
                    ],
                    "properties": {
                        "localized": {
                            "const": false
                        }
                    }
                }
            ]
        },
        "velocity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "vx",
                "vy",
                "omega"
            ],
            "properties": {
                "vx": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308,
                    "unit": "m/s"
                },
                "vy": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308,
                    "unit": "m/s"
                },
                "omega": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308,
                    "unit": "rad/s"
                }
            }
        }
    }
}
